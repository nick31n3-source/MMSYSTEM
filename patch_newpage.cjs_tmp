import puppeteer from 'puppeteer';
import fs from 'fs';

const wait = ms => new Promise(r => setTimeout(r, ms));

async function runTest() {
  const browser = await puppeteer.launch({ args: ['--no-sandbox', '--disable-setuid-sandbox'] });
  const page = await browser.newPage();
  page2.on('console', msg => console.log('BROWSER:', msg.text()));
  
  try {
    await page2.goto('http://localhost:3000');
    
    // --- 1. Superuser Login ---
    console.log("-> Logging in as Superuser");
    await page2.waitForFunction(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const suBtn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('ACESSO SUPERUSUARIO'));
      if (suBtn) { suBtn.click(); return true; }
      return false;
    });
    
    await wait(500);
    await page2.evaluate(() => document.getElementById('username').value = '');
    await page2.type('#username', 'nick31');
    await page2.evaluate(() => document.getElementById('password').value = '');
    await page2.type('#password', 'password');
    await page2.evaluate(() => document.querySelector('button[type="submit"]').click());
    
    await page2.waitForFunction(() => {
        const btns = Array.from(document.querySelectorAll('button'));
        return btns.some(b => b.textContent && b.textContent.toUpperCase().includes('GERENCIAMENTO DE CLIENTES'));
    }, {timeout: 10000});
    console.log("✅ Superuser Login successful!");
    
    // --- 2. Create Tenant ---
    console.log("-> Creating Tenant");
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('ADICIONAR CLIENTE'));
      if (btn) btn.click();
    });
    
    await wait(1000);
    
    const clientName = 'Test Client ' + Date.now();
    
    // Clear and type properly for all required inputs
    await page2.evaluate((clientName) => {
      const setVal = (selector, val) => {
        const el = document.querySelector(selector);
        if(!el) return;
        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        nativeSetter.call(el, val);
        el.dispatchEvent(new Event('input', { bubbles: true }));
      };
      setVal('input[placeholder="Ex: Pizzaria Forno Nobre"]', clientName);
      setVal('input[placeholder="Ex: Guilherme Costa"]', 'Owner Name');
      setVal('input[placeholder="Ex: financeiro@forno.com.br"]', 'client@test.com');
      setVal('input[placeholder="Ex: bistro_admin"]', 'client_adminx');
      setVal('input[placeholder="Senha do cliente"]', 'password123');
    }, clientName);
    
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('INICIALIZAR INSTÂNCIA'));
      if (btn) btn.click();
    });
    await wait(1000);

    // Click the confirmation modal button
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('PROVISIONAR INSTÂNCIA'));
      if (btn) btn.click();
    });
    await wait(2000);
    console.log("✅ Tenant Creation simulated!");
    
    // Log out
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && (b.textContent.toUpperCase().includes('SAIR') || b.textContent.toUpperCase().includes('LOGOUT')));
      if (btn) btn.click();
    });
    await wait(2000);
    
    // --- 3. Client Login ---
    console.log("-> Logging in as Client");
    const page2 = await browser.newPage();
    page2.on('console', msg => console.log('BROWSER2:', msg.text()));
    await page2.goto("http://localhost:3000");
    await wait(1000);
    await page2.waitForFunction(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const suBtn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('ACESSO CLIENTE'));
      if (suBtn) { suBtn.click(); return true; }
      return false;
    });
    
    await wait(500);
    await page2.evaluate(() => document.getElementById('username').value = '');
    await page2.type('#username', 'client_adminx');
    await page2.evaluate(() => document.getElementById('password').value = '');
    await page2.type('#password', 'password123');
    await page2.click('button[type="submit"]');
    
    try {
      await page2.waitForFunction(() => {
          const btns = Array.from(document.querySelectorAll('button'));
          return btns.some(b => b.textContent && b.textContent.toUpperCase().includes('ESTOQUE'));
      }, {timeout: 10000});
      console.log("✅ Client Login successful!");
    } catch(e) {
      console.error(e);
      const html = await page2.content();
      const fs = await import('fs');
      fs.writeFileSync('e2e-client-fail.html', html);
      throw e;
    }
    
    // --- 4. Inventory Creation ---
    console.log("-> Adding to Inventory");
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('ESTOQUE'));
      if (btn) btn.click();
    });
    await wait(1000);
    
    const hasAddBtn = await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('CADASTRAR'));
      if (btn) { btn.click(); return true; }
      return false;
    });
    
    await wait(1000);
    
    const invInputs = await page2.$$('input');
    // Assume text input is Farinha de Trigo
    await invInputs[0].click();
    await page2.keyboard.type('Farinha de Trigo');
    
    const numInputs = await page2.$$('input[type="number"]');
    await numInputs[0].click();
    await page2.keyboard.type('10'); // stock
    await numInputs[1].click();
    await page2.keyboard.type('5'); // unit price
    await numInputs[2].click();
    await page2.keyboard.type('2'); // min stock
    
    await page2.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('button'));
      const btn = btns.find(b => b.textContent && (b.textContent.toUpperCase().includes('ADICIONAR') || b.textContent.toUpperCase().includes('SALVAR')));
      if (btn) btn.click();
    });
    await wait(1000);
    console.log("✅ Inventory Added!");
    
    // --- Load Simulation ---
    console.log("-> Simulating Load...");
    for(let i=0; i<5; i++) {
        await page2.evaluate(() => {
          const btns = Array.from(document.querySelectorAll('button'));
          const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('CARDAPIO'));
          if (btn) btn.click();
        });
        await wait(200);
        await page2.evaluate(() => {
          const btns = Array.from(document.querySelectorAll('button'));
          const btn = btns.find(b => b.textContent && b.textContent.toUpperCase().includes('VENDAS'));
          if (btn) btn.click();
        });
        await wait(200);
    }
    console.log("✅ Load simulation completed stably!");
    
  } catch (err) {
    console.error("❌ E2E TEST FAILED:", err);
    const html = await page2.content();
    fs.writeFileSync('error.html', html);
  } finally {
    await browser.close();
  }
}

runTest();
